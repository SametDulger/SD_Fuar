@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center">
    <h1 class="text-danger">Hata!</h1>
    <h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>
</div>

@if (Model.ShowRequestId)
{
    <div class="alert alert-info">
        <p>
            <strong>İstek ID:</strong> <code>@Model.RequestId</code>
        </p>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <h3>Geliştirme Modu</h3>
                <p>
                    <strong>Development</strong> ortamına geçiş yaparak, oluşan hata hakkında daha detaylı bilgi alabilirsiniz.
                </p>
                <p>
                    <strong>Production ortamında Development modu etkinleştirilmemelidir.</strong>
                    Bu, kullanıcılara hassas bilgilerin görüntülenmesine neden olabilir.
                </p>
                <p>
                    Yerel hata ayıklama için, <strong>ASPNETCORE_ENVIRONMENT</strong> ortam değişkenini <strong>Development</strong> olarak ayarlayın
                    ve uygulamayı yeniden başlatın.
                </p>
                
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</div>
